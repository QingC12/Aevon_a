  "icon_pad": {
    "version": 4,
    "module": "Stheno.dylib",
    "surface": "ring icon background plate",
    "light_branch": "UIColor.blackColor -> Color(uiColor:)",
    "dark_branch": "SwiftUI Color.black (unchanged)",
    "selector_ref_offset": "0xe6798",
    "selector_name_offset": "0xd3114",
    "original": "secondarySystemBackgroundColor",
    "replacement": "blackColor",
    "patched_bytes": "31 equal-length bytes, NUL padded",
    "defect": "the light-mode plate is mixed at roughly a quarter strength, so a base colour that is itself near the backdrop disappears: secondarySystemBackground (242) gave 237 on a 235 capsule, secondarySystemFill (217) gave 229, opaque systemGray4 (209) still gave 229 and darkGray (85) gave only 197, which still reads as faint next to the capsule on white and pale grey wallpapers",
    "effect": "the plate base colour is black (0), the darkest base UIColor offers, which the plate mixes at about a quarter, so the plate lands at 0.75 * backdrop: about B0 on a EB ring capsule and BF on white. That is a clearly separated grey disc, not the near black plate of the dark branch",
    "scope": "one selector reference in one branch; ring geometry, icon placement, animation and the dark branch are untouched",
    "regression_gate": "the core must carry blackColor at 0xd3114 in addition to its one unrelated occurrence, and must contain none of darkGrayColor, systemGray4Color, secondarySystemFillColor or secondarySystemBackgroundColor",
    "byte_patch": {
      "offset": "0xd3114",
      "length": 31,
      "original": "secondarySystemBackgroundColor",
      "replacement": "blackColor",
      "note": "the 31 bytes are one NUL-terminated selector name plus its padding; no instruction stream, header or fixup word is touched"
    },
    "previous": "darkGrayColor",
    "composite_alpha": 0.25,
    "composite_floor": "the plate can never be darker than 0.75 * backdrop with a colour swap alone"
  }
