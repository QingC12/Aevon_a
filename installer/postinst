#!/bin/sh
set +e


KEYVAL=REXIIUA5FF8288VP

# The retired SthenoKeyboard module swizzles
# -[UIApplication openURL:options:completionHandler:] in every injected app. Its
# replacement returns the URL object where a BOOL is required and, whenever the
# universal-link option is present, re-issues the open with an empty options
# dictionary and a nil completion handler. Payment jumps that depend on that
# contract never run their fallback (Alipay), while custom-scheme jumps (WeChat)
# are unaffected. Drop any copy an earlier installation left behind so the module
# can never load again. Only these two exact paths are touched.
for L in /Library/MobileSubstrate/DynamicLibraries \
         /var/jb/Library/MobileSubstrate/DynamicLibraries ; do
  [ -d "$L" ] || continue
  rm -f "$L/SthenoKeyboard.dylib" "$L/SthenoKeyboard.plist" 2>/dev/null
done

:
:

SRC=""
for c in /var/mobile/Library/Preferences/com.nx.stheno.plist \
         /var/jb/var/mobile/Library/Preferences/com.nx.stheno.plist \
         /var/jb/usr/local/share/stheno/com.nx.stheno.plist \
         /usr/local/share/stheno/com.nx.stheno.plist ; do
  [ -f "$c" ] && { SRC="$c"; break; }
done
:
[ -n "$SRC" ] || exit 0
:
if grep -a -q "$KEYVAL" "$SRC" 2>/dev/null ; then
  :
else
  :
fi

killall -9 cfprefsd 2>/dev/null
sleep 1 2>/dev/null

# Only use a root-owned, non-writable ancestry. /var is normally a system
# symlink on iOS; resolve it once before checking every physical component.
# /var/root lives on the data volume used by mobile and RootHide. If a target
# is on another volume, ln fails closed: never fall back to cp/mv into it.
private_stage() (
  # Prefer the physical data-volume root; RootHide may remap /var/root.
  for BASE in /private/var/root /var/root ; do
    (
      P=$(cd -P "$BASE" 2>/dev/null && pwd -P) || exit 1
      C=$P
      while : ; do
        [ -d "$C" ] && [ ! -L "$C" ] || exit 1
        M=$(stat -f '%u:%Lp' "$C" 2>/dev/null) ||
          M=$(stat -c '%u:%a' "$C" 2>/dev/null) || exit 1
        case "$M" in 0:*) M=${M#*:} ;; *) exit 1 ;; esac
        case "$M" in ''|*[!0-7]*) exit 1 ;; esac
        [ $((0$M & 0022)) -eq 0 ] || exit 1
        [ "$C" != / ] || break
        C=${C%/*}; [ -n "$C" ] || C=/
      done
      umask 077
      mktemp -d "$P/.stheno-install.XXXXXXXX" 2>/dev/null
    ) && exit 0
  done
  exit 1
)
STAGE=$(private_stage)
cleanup() {
  [ -n "$STAGE" ] || return
  rm -f "$STAGE/com.nx.stheno.plist" 2>/dev/null
  rmdir "$STAGE" 2>/dev/null
}
trap cleanup 0
trap 'exit 0' HUP INT TERM

seed_preferences() (
  # Pin the directory, so a concurrent parent rename cannot redirect the link.
  cd -P "$1" 2>/dev/null || exit 1
  # A mobile-controlled Preferences/RootHide symlink must not let root publish
  # a new file in an unrelated directory. /var itself may resolve to /private.
  A=$(pwd -P) || exit 1
  Q=
  case "$A" in
    /var/mobile/Library/Preferences|/private/var/mobile/Library/Preferences) ;;
    /var/containers/Bundle/Application/.jbroot-*/*)
      Q=${A#/var/containers/Bundle/Application/} ;;
    /private/var/containers/Bundle/Application/.jbroot-*/*)
      Q=${A#/private/var/containers/Bundle/Application/} ;;
    *) exit 1 ;;
  esac
  if [ -n "$Q" ] ; then
    J=${Q%%/*}
    case "$J" in .jbroot-?*) ;; *) exit 1 ;; esac
    case "${Q#*/}" in
      var/mobile/Library/Preferences|private/var/mobile/Library/Preferences) ;;
      *) exit 1 ;;
    esac
  fi
  T=./com.nx.stheno.plist
  [ -e "$T" ] || [ -L "$T" ] || {
    [ -n "$STAGE" ] || exit 1
    TMP="$STAGE/com.nx.stheno.plist"
    # This name is opened only inside the root-private directory, never in
    # Preferences. Finish all content/metadata changes before publishing it.
    if ( umask 077; set -C; cat "$SRC" > "$TMP" ) 2>/dev/null &&
       chown mobile:mobile "$TMP" 2>/dev/null &&
       chmod 0600 "$TMP" 2>/dev/null ; then
      # Directory operand + matching basename makes link(2) fail on ANY
      # existing entry, including a symlink-to-directory or a directory.
      # No -f, no target-file chmod/chown, and no cross-volume fallback.
      ln "$TMP" ./ 2>/dev/null
      OK=$?
    else
      OK=1
    fi
    rm -f "$TMP" 2>/dev/null
    [ "$OK" -eq 0 ] || exit 1
  }
)

N=0
for J in /var/containers/Bundle/Application/.jbroot-* \
         /private/var/containers/Bundle/Application/.jbroot-* ; do
  [ -d "$J" ] || continue
  for D in "$J/var/mobile/Library/Preferences" \
           "$J/private/var/mobile/Library/Preferences" ; do
    [ -d "$D" ] || continue
    seed_preferences "$D" && N=$((N + 1))
  done
done
:

# The shipped seed already contains Key and Inject defaults. Initialize the
# primary domain only if absent, through the same atomic no-clobber path.
# defaults write would overwrite a custom Key, mutate existing metadata, and
# race a concurrently-created configuration even after an existence check.
seed_preferences /var/mobile/Library/Preferences

:
for J in /var/containers/Bundle/Application/.jbroot-* ; do
  [ -d "$J" ] || continue
  for D in "$J/var/mobile/Library/Preferences" "$J/private/var/mobile/Library/Preferences" ; do
    [ -f "$D/com.nx.stheno.plist" ] || continue
    if grep -a -q "$KEYVAL" "$D/com.nx.stheno.plist" 2>/dev/null ; then
      :
    else
      :
    fi
  done
done
:
if command -v defaults >/dev/null 2>&1 ; then
  :
fi

if [ -f /var/mobile/Documents/SthenoAutoRespring ] ; then
  :
  sync
  killall -9 SpringBoard 2>/dev/null
else
  :
  :
fi
sync
exit 0
